{
  "name": "reflexmesh",
  "version": "0.2.0-alpha.1",
  "private": true,
  "description": "Provider-neutral semantic decision runtime with deterministic policy and auditable outcomes",
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "demo": "npm run build && node examples/workflow.mjs",
    "demo:jev": "npm run build && node examples/jev.mjs",
    "check": "npm run typecheck && npm test",
    "publish:github": "node scripts/publish-github.mjs",
    "demo:durable": "npm run build && node examples/durable-shadow.mjs",
    "compat:hosts": "npm run build && node scripts/real-host-compat.mjs",
    "compat:claude-local": "npm run build && node scripts/claude-local-probe.mjs",
    "compat:claude-setup": "npm run build && node scripts/claude-setup-probe.mjs",
    "compat:claude-failure": "npm run build && node scripts/claude-failure-probe.mjs",
    "compat:claude-resume": "npm run build && node scripts/claude-resume-probe.mjs",
    "mcp:stdio": "node adapters/mcp-server.mjs",
    "hook:claude": "node adapters/claude-hook.mjs",
    "recovery": "node adapters/recovery-cli.mjs",
    "evidence": "node adapters/evidence-cli.mjs",
    "doctor": "node adapters/doctor-cli.mjs",
    "doctor:claude": "node adapters/claude-doctor-cli.mjs",
    "demo:evidence": "npm run build && node examples/task-intent.mjs --explain",
    "demo:recovery": "npm run build && node examples/recovery-review.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
